# Copy to backend/.env and adjust. Every value is optional.

# Web server
PORT=8000
# Keep 127.0.0.1 behind a reverse proxy (Caddy/Nginx). Docker sets 0.0.0.0.
HOST=127.0.0.1

# Persistent storage. On a real host, point both at a disk that survives redeploys,
# and back up both together.
# ALFA_DATA_DIR=/var/lib/alfa/data
# ALFA_UPLOAD_DIR=/var/lib/alfa/uploads

# Built React site. Defaults to ../frontend/dist.
# ALFA_FRONTEND_DIST=/opt/alfa/frontend/dist

# Which proxies may set X-Forwarded-For / X-Forwarded-Proto. "loopback" fits a proxy
# on the same machine. Use a number of hops (e.g. 1) on platforms like Render/Railway.
TRUST_PROXY=loopback
